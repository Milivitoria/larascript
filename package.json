{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "tsx watch src/server.ts",
        "dev:web": "vite",
        "build": "npm run typecheck && npm run build:web",
        "build:web": "vite build",
        "start": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "validate:openapi": "tsx scripts/validate-openapi.ts"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^12.1.0",
        "@biomejs/biome": "^2.4.15",
        "@types/node": "^25.6.2",
        "concurrently": "^9.2.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^4.1.6"
    },
    "dependencies": {
        "@hono/node-server": "^2.0.2",
        "@hono/swagger-ui": "^0.6.1",
        "@hono/zod-openapi": "^1.4.0",
        "hono": "^4.12.18",
        "zod": "^4.4.3"
    }
}
